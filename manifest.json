{
  "$schema": "https://raw.githubusercontent.com/InkSha/sumi/refs/heads/master/schema/v1/plugin.schema.json",
  "name": "sumi-plugin-hash",
  "version": "1.0.0",
  "description": "hash plugin",
  "author": "InkSha",
  "license": "MIT",
  "repo": "https://github.com/summink/sumi-plugin-hash",
  "doc": "https://github.com/summink/sumi-plugin-hash",
  "platforms": [
    {
      "os": "windows",
      "arch": "amd64"
    },
    {
      "os": "windows",
      "arch": "x86"
    },
    {
      "os": "linux",
      "arch": "amd64"
    },
    {
      "os": "macos",
      "arch": "amd64"
    }
  ],
  "tags": [
    "hash"
  ],
  "args": [
    {
      "name": "value",
      "type": "string",
      "description": "value to hash",
      "required": true
    }
  ],
  "flags": [
    {
      "name": "file",
      "type": "string",
      "description": "file to hash",
      "required": false
    },
    {
      "name": "mode",
      "type": "string",
      "description": "hash mode",
      "required": false
    },
    {
      "name": "copy",
      "type": "bool",
      "description": "copy hash to clipboard",
      "required": false
    }
  ]
}
